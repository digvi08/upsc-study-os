# Copy these to Render → Environment (production)
ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=GENERATE_WITH_python_-c_import_secrets_print_secrets_token_hex_32

ALLOWED_ORIGINS=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

AI_PROVIDER=auto
OPENAI_API_KEY=sk-optional
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set GEMMINI_API_BASE_URL to your Gemmini-compatible OpenAI endpoint, e.g. https://your-gemmini-host/v1
GEMMINI_API_BASE_URL=
GEMMINI_API_KEY=
GEMMINI_MODEL=gemmini-1
GEMMINI_EMBEDDING_MODEL=gemmini-embedding-1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
