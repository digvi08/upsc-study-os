# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="AI UPSC Study OS"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database (Neon) — use "Pooled connection" from Neon dashboard ─────────────
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# ── JWT — generate: python -c "import secrets; print(secrets.token_hex(32))" ─
SECRET_KEY=your-local-dev-secret-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty — defaults to FRONTEND_URL/auth/google/callback
GOOGLE_REDIRECT_URI=

# ── AI provider selection ─────────────────────────────────────────────────────
AI_PROVIDER=auto

# ── OpenAI (optional — demo mode works without key) ───────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Gemmini (optional) ───────────────────────────────────────────────────────
# Set GEMMINI_API_BASE_URL to your Gemmini-compatible OpenAI endpoint, e.g. https://your-gemmini-host/v1
GEMMINI_API_BASE_URL=
GEMMINI_API_KEY=
GEMMINI_MODEL=gemmini-1
GEMMINI_EMBEDDING_MODEL=gemmini-embedding-1

# ── Redis (optional) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS — comma-separated; add your Vercel URL after deploy ─────────────────
ALLOWED_ORIGINS=http://localhost:4200,https://your-app.vercel.app

# ── Frontend URL (OAuth + emails) ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Email (optional) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
